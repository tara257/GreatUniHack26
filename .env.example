# Match the Java Edition version selected in your Minecraft launcher.
MC_VERSION=1.21.1
MC_PORT=25565
# Bots use the local test server; their state is kept separately in this folder.
BOT_STATE_DIR=.state

# Separate communication relay; no Minecraft bot integration is enabled yet.
COMMS_HOST=127.0.0.1
COMMS_PORT=8090
COMMS_URL=ws://127.0.0.1:8090/agents
# Optional shared agent credential. Never give agents the operator credential.
# COMMS_AGENT_TOKEN=choose-a-long-random-agent-secret
# If omitted, the server generates and prints a fresh operator token on startup.
# COMMS_OPERATOR_TOKEN=choose-a-different-long-random-operator-secret

# Who joins: a comma-separated list of miner, lumberjack, builder, crafter, scout — or "all".
# Default is all five.
TEAM_ROLES=all

# Shared storage chest location and house origin. Default: storage at world spawn,
# house 6 blocks east / 2 blocks north of it. Format: x,y,z
# STORAGE_POS=0,64,0
# BUILD_ORIGIN=6,64,-2

# Carrying thresholds before returning to storage.
MINER_DEPOSIT=32
LUMBERJACK_DEPOSIT=16
# How many spiral rings (24 blocks apart) the scout covers before starting over.
SCOUT_RINGS=6
